{
  "name": "crux-worker",
  "main": "src/index.ts",
  // DEV_NOTE: keep it up to date with the current date.
  "compatibility_date": "2026-05-22",
  // DEV_NOTE: nodejs_compat flag is needed for using AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_CORS_ORIGIN": "http://localhost:3000",
    // DEV_NOTE: "local" is the only value that enables the checkAuth bypass in AuthMiddleware.ts — must be an exact match, staging/production below override this.
    "APP_ENV": "local",
    // DEV_NOTE: VAPID_PUBLIC_KEY/VAPID_SUBJECT are plain vars, not secrets — a public key has nothing
    // to protect (it's served to every browser via GET /notifications/vapid-public-key and handed to
    // pushManager.subscribe()), and VAPID_SUBJECT is just a contact mailto:. Only VAPID_PRIVATE_KEY
    // is a secret (.dev.vars locally, `wrangler secret put` in staging/production).
    // Same value in every env block below deliberately — staging/production/local share one physical
    // D1 (see the d1_databases DEV_NOTE), so push_subscriptions is one shared table: a subscription
    // created under one public key can only ever be signed for by its matching private key, so every
    // environment has to run the same VAPID identity or sends start failing with a silent 401.
    "VAPID_PUBLIC_KEY": "BG2-5T2DP7LLQOdb9mjyJge7iOoMuJjxz4vN4pTWg2NJMA9H1_KvN2z6T0QKBoQkDNOR_cwUStX-mg3geMaUjXY",
    "VAPID_SUBJECT": "mailto:hatiprithwish@gmail.com",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  // DEV_NOTE: Cloudflare Images, transformations only — the Free plan covers optimizing images
  // stored outside Images (ours live in R2), 5,000 unique transformations a month. Used once per
  // upload (downscale + WebP) in MediaRepo, never on read, so serving costs no transformations.
  "images": {
    "binding": "IMAGES",
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "neuron-media",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crux-db",
      "database_id": "8c4994d0-094e-42ef-a1bf-5d2cc24c8b82",
      "migrations_dir": "src/db/migrations",
      "remote": true,
    },
  ],
  "env": {
    "staging": {
      "name": "crux-worker-staging",
      "vars": {
        "ALLOWED_CORS_ORIGIN": "http://localhost:3000,https://crux-web-staging.hatiprithwish.workers.dev",
        "APP_ENV": "staging",
        "VAPID_PUBLIC_KEY": "BG2-5T2DP7LLQOdb9mjyJge7iOoMuJjxz4vN4pTWg2NJMA9H1_KvN2z6T0QKBoQkDNOR_cwUStX-mg3geMaUjXY",
        "VAPID_SUBJECT": "mailto:hatiprithwish@gmail.com",
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
        },
      },
      // DEV_NOTE: Cloudflare Images, transformations only — the Free plan covers optimizing images
      // stored outside Images (ours live in R2), 5,000 unique transformations a month. Used once per
      // upload (downscale + WebP) in MediaRepo, never on read, so serving costs no transformations.
      "images": {
        "binding": "IMAGES",
      },
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "crux-media-staging",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "crux-db",
          "database_id": "8c4994d0-094e-42ef-a1bf-5d2cc24c8b82",
          "migrations_dir": "src/db/migrations",
          "remote": true,
        },
      ],
    },
    "production": {
      "name": "crux-worker",
      "vars": {
        "ALLOWED_CORS_ORIGIN": "https://crux-web.hatiprithwish.workers.dev",
        "APP_ENV": "production",
        "VAPID_PUBLIC_KEY": "BG2-5T2DP7LLQOdb9mjyJge7iOoMuJjxz4vN4pTWg2NJMA9H1_KvN2z6T0QKBoQkDNOR_cwUStX-mg3geMaUjXY",
        "VAPID_SUBJECT": "mailto:hatiprithwish@gmail.com",
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
        },
      },
      // DEV_NOTE: Cloudflare Images, transformations only — the Free plan covers optimizing images
      // stored outside Images (ours live in R2), 5,000 unique transformations a month. Used once per
      // upload (downscale + WebP) in MediaRepo, never on read, so serving costs no transformations.
      "images": {
        "binding": "IMAGES",
      },
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "crux-media",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "crux-db",
          "database_id": "8c4994d0-094e-42ef-a1bf-5d2cc24c8b82",
          "migrations_dir": "src/db/migrations",
          "remote": true,
        },
      ],
      // DEV_NOTE: architecture.md §4.1 point 3 — weekly orphan scan, Sunday 00:00 UTC. Production
      // only: staging has no real user data for a referential-integrity check to be meaningful.
      // DEV_NOTE: weekday is spelled "SUN", not 0. Cloudflare's weekday field is 1-7 with
      // 1 = Sunday (NOT the usual 0-6), so "0 0 * * 0" is out of range and the API rejects the
      // deploy with "invalid cron string [code: 10100]". The abbreviation avoids the off-by-one.
      // DEV_NOTE: "0 * * * *" is the hourly notification dispatch (Constants.CRON_NOTIFICATION_
      // DISPATCH) — production only, same reasoning as the orphan scan: staging has no real
      // subscriptions or reminder hours for an hourly send loop to be meaningful, and it would
      // just burn subrequests against test data every hour.
      "triggers": {
        "crons": ["0 0 * * SUN", "0 * * * *"],
      },
    },
  },
}
